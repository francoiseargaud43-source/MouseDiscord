# Copiez ce fichier en .env et renseignez vos valeurs (ne jamais committer .env)
# Booléens : true/false (aussi 1/0, yes/no, on/off, oui/non, vrai/faux). Toute autre valeur
# empêche le démarrage et le message indique les orthographes acceptées.
# Jeton du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Salon du Finder : clic droit > Copier l'identifiant
# 0 = le salon où la commande est tapée (utile pour essayer sur un serveur de test)
FINDER_CHANNEL_ID=
# Préfixe des commandes texte, par exemple !aide
COMMAND_PREFIX=!
# Mettre le salon du Finder en lecture seule pour @everyone au moment du setup
LOCK_FINDER_CHANNEL=true
# Durée de vie d'un parcours en cours, en secondes (1800 = 30 minutes)
SESSION_TTL_SECONDS=1800
# Conserver les parcours en cours dans state/sessions.json (false = mémoire seulement)
SESSION_PERSIST=true
# Base publique des illustrations, utilisée quand assets/images.json ne contient que des noms
# de fichiers repris de assets/illustrations/. Exemple : https://moncompte.alwaysdata.net/illustrations/
# Les URL https:// complètes écrites dans assets/images.json restent utilisées telles quelles.
IMAGES_BASE_URL=
